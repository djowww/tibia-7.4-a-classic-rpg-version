HallImage < UIWidget
  anchors.top: parent.top
  anchors.left: parent.left
  image-smooth: false
  phantom: true
  focusable: false

HallFrame < HallImage
  border: 1 #f4dc9a

HallSpot < UIWidget
  anchors.top: parent.top
  anchors.left: parent.left
  image-smooth: false
  focusable: false

HallTier < UIWidget
  size: 78 52
  focusable: false

  UIWidget
    id: slot
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    size: 34 34
    image-source: /images/ui/item
    phantom: true

    UIWidget
      id: item
      anchors.centerIn: parent
      size: 32 32
      image-source: /images/achievements/hall_items
      image-smooth: false
      phantom: true

  Label
    id: caption
    anchors.top: slot.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    height: 14
    text-align: center
    color: #8f8e84
    phantom: true

HallBonus < UIWidget
  size: 64 32

  UIWidget
    id: icon
    anchors.top: parent.top
    anchors.left: parent.left
    size: 32 32
    image-source: /images/achievements/hall_icons
    image-smooth: false
    phantom: true

  Label
    id: value
    anchors.left: icon.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    height: 14
    font: verdana-11px-rounded
    color: #DDD8C6
    text-align: left
    phantom: true

HallPlaque < Panel
  anchors.top: parent.top
  anchors.left: parent.left
  background-color: #2b2b29f2
  border: 1 #77766b
  padding: 10

MainWindow
  id: achievementWindow
  text: Achievements
  size: 1214 675
  padding-top: 28
  padding-left: 7
  padding-right: 7
  padding-bottom: 7
  @onEscape: modules.game_achievements.hide()

  UIWidget
    id: hall
    anchors.top: parent.top
    anchors.left: parent.left
    size: 1200 640
    background-color: #000000
    image-source: /images/achievements/hall
    image-smooth: false

  UIWidget
    id: rankIcon
    anchors.top: parent.top
    anchors.left: parent.left
    margin-top: 6
    margin-left: 12
    size: 64 32
    image-source: /images/achievements/hall_ranks
    image-clip: 0 0 64 32
    image-smooth: false

  Label
    id: rankName
    anchors.top: parent.top
    anchors.left: rankIcon.right
    margin-top: 6
    margin-left: 6
    size: 170 16
    font: verdana-11px-rounded
    color: #e2bd55
    text: Novice
    text-align: left
    phantom: true

  UIProgressBar
    id: rankBar
    anchors.top: rankName.bottom
    anchors.left: rankName.left
    margin-top: 2
    size: 170 14
    background-color: #8E805E
    border: 1 #1c1d1b
    background-border: 1
    color: #f2ecd8
    text-align: center

  Label
    id: message
    anchors.top: rankIcon.bottom
    anchors.left: rankIcon.left
    margin-top: 4
    size: 420 14
    color: #AAA99E
    text: Connect to the game to view your achievement progress.
    text-align: left
    phantom: true

  Panel
    id: bonuses
    anchors.top: parent.top
    anchors.right: hall.right
    margin-top: 6
    margin-right: 12
    size: 262 32
    layout:
      type: horizontalBox
      spacing: 2
      fit-children: false

    HallBonus
      id: speed
      tooltip: Speed bonus

    HallBonus
      id: attack
      tooltip: Damage bonus on direct physical and magic hits

    HallBonus
      id: pvp
      tooltip: Extra damage against players

    HallBonus
      id: death
      tooltip: Smaller loss on death

  Button
    id: claimButton
    anchors.top: bonuses.bottom
    anchors.right: bonuses.right
    margin-top: 4
    width: 114
    height: 22
    text: Claim rewards
    enabled: false
    visible: false
    tooltip: Receive earned item rewards after making room in your inventory.
    @onClick: modules.game_achievements.claimRewards()

  HallPlaque
    id: plaque
    size: 496 104

    UIWidget
      id: bigFrame
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 68 68
      image-source: /images/ui/item
      image-smooth: false

      UIWidget
        id: bigItem
        anchors.centerIn: parent
        size: 64 64
        image-source: /images/achievements/hall_items
        image-smooth: false
        phantom: true

    Label
      id: trackName
      anchors.top: parent.top
      anchors.left: bigFrame.right
      anchors.right: parent.right
      margin-top: 14
      margin-left: 12
      height: 16
      font: verdana-11px-rounded
      color: #e2bd55
      text-align: left

    Label
      id: reward
      anchors.top: trackName.top
      anchors.left: trackName.left
      anchors.right: parent.right
      height: 16
      font: verdana-11px-rounded
      color: #8fbf7a
      text-align: right
      phantom: true

    UIProgressBar
      id: bar
      anchors.top: trackName.bottom
      anchors.left: trackName.left
      anchors.right: parent.right
      margin-top: 8
      height: 16
      background-color: #8E805E
      border: 1 #1c1d1b
      background-border: 1
      color: #f2ecd8
      text-align: center

  HallPlaque
    id: tiers
    size: 452 104

    Panel
      id: tierRow
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      height: 52
      layout:
        type: horizontalBox
        spacing: 3
        fit-children: false

      HallTier
        id: tier1

      HallTier
        id: tier2

      HallTier
        id: tier3

      HallTier
        id: tier4

      HallTier
        id: tier5
