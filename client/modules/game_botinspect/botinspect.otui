BotInspectHeading < Label
  height: 14
  color: #F0C860
  font: verdana-11px-rounded
  text-align: left

BotInspectText < Label
  color: #C8C8C8
  text-align: topLeft
  text-wrap: true
  text-auto-resize: true

MainWindow
  id: botInspectWindow
  text: Inspect bot
  size: 460 470
  @onEscape: modules.game_botinspect.hide()

  FlatPanel
    id: header
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 92

    Label
      id: title
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: percent.left
      margin: 8 10 0 10
      height: 16
      color: #FFFFFF
      font: verdana-11px-rounded
      text-align: left

    Label
      id: verdict
      anchors.top: title.bottom
      anchors.left: title.left
      anchors.right: percent.left
      margin-top: 5
      height: 14
      text-align: left

    Label
      id: data
      anchors.top: verdict.bottom
      anchors.left: title.left
      anchors.right: percent.left
      margin-top: 4
      height: 14
      color: #B4B4B4
      text-align: left

    Label
      id: percent
      anchors.top: parent.top
      anchors.right: parent.right
      margin: 6 12 0 0
      width: 110
      height: 44
      font: sans-bold-16px
      text-align: right

    UIWidget
      id: barFrame
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin: 0 10 10 10
      height: 12
      background-color: #1c1c1c
      border: 1 #000000

      UIProgressBar
        id: bar
        anchors.fill: parent
        margin: 1
        background-color: #7FCF6A
        phantom: true

  Label
    id: checkState
    anchors.top: header.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    height: 14
    color: #C8C8C8
    text-align: left

  Label
    id: note
    anchors.top: checkState.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 3
    height: 14
    color: #7FB8FF
    text-align: left

  ScrollablePanel
    id: body
    anchors.top: note.bottom
    anchors.left: parent.left
    anchors.right: bodyScroll.left
    anchors.bottom: separator.top
    margin-top: 6
    margin-right: 3
    margin-bottom: 8
    vertical-scrollbar: bodyScroll
    layout:
      type: verticalBox
      spacing: 4

    BotInspectHeading
      text: Signals

    BotInspectText
      id: reasons

    BotInspectHeading
      text: Details
      margin-top: 6

    BotInspectText
      id: details
      color: #9A9A9A

  VerticalScrollBar
    id: bodyScroll
    anchors.top: note.bottom
    anchors.right: parent.right
    anchors.bottom: separator.top
    margin-top: 6
    margin-bottom: 8
    step: 28
    pixels-scroll: true

  HorizontalSeparator
    id: separator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeButton.top
    margin-bottom: 8

  Button
    id: checkButton
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 110
    text: Start bot check
    tooltip: Sends a sum to the player. The answer (or no answer in 3 minutes) is reported here and in the chat.
    @onClick: modules.game_botinspect.check()

  Button
    id: clearButton
    anchors.left: checkButton.right
    anchors.bottom: parent.bottom
    margin-left: 6
    width: 110
    text: Mark as human
    tooltip: Clears the score and pauses the alerts for 2 hours.
    @onClick: modules.game_botinspect.clear()

  Button
    id: refreshButton
    anchors.left: clearButton.right
    anchors.bottom: parent.bottom
    margin-left: 6
    width: 70
    text: Refresh
    @onClick: modules.game_botinspect.refresh()

  Button
    id: closeButton
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 70
    text: Close
    @onClick: modules.game_botinspect.hide()
