NpcTradeTab < Button
  size: 96 20
  color: #C3C3BC

  $on:
    image-clip: 0 46 22 23
    color: #FFFFFF

NpcTradeCell < UIWidget
  focusable: false

  Item
    id: item
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    virtual: true
    phantom: true

  Label
    id: have
    anchors.right: item.right
    anchors.bottom: item.bottom
    margin-right: 2
    margin-bottom: 1
    font: verdana-11px-rounded
    text-auto-resize: true
    color: #FFFFFF
    phantom: true

  Label
    id: price
    anchors.top: item.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 1
    height: 14
    text-align: center
    color: #E2BD55
    phantom: true

MainWindow
  id: npcShopWindow
  text: Trade
  size: 546 503
  @onEscape: modules.game_npcshop.hide()

  UIWidget
    id: scene
    anchors.top: parent.top
    anchors.left: parent.left
    size: 512 208
    image-source: /images/npcshop/counter
    border: 1 #000000

    UICreature
      id: npc
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 56
      margin-left: 208
      size: 64 64
      phantom: true

    UIItem
      id: item
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 108
      margin-left: 208
      size: 64 64
      virtual: true
      phantom: true

    UIItem
      id: coins
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 110
      margin-left: 286
      size: 64 64
      virtual: true
      phantom: true

    Label
      id: total
      anchors.verticalCenter: coins.verticalCenter
      anchors.left: coins.right
      margin-left: 2
      font: verdana-11px-rounded
      text-auto-resize: true
      color: #E2BD55
      phantom: true

    Label
      id: say
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin: 6 20 0 20
      height: 42
      font: verdana-11px-rounded
      text-wrap: true
      text-align: center
      color: #F7F700
      phantom: true

  NpcTradeTab
    id: buyTab
    anchors.top: scene.bottom
    anchors.left: parent.left
    margin-top: 6
    text: Buy
    @onClick: modules.game_npcshop.setMode('buy')

  NpcTradeTab
    id: sellTab
    anchors.top: buyTab.top
    anchors.left: buyTab.right
    margin-left: 2
    text: Sell
    @onClick: modules.game_npcshop.setMode('sell')

  Label
    id: capacity
    anchors.verticalCenter: buyTab.verticalCenter
    anchors.right: parent.right
    text-auto-resize: true
    color: #DDD8C6

  Label
    id: money
    anchors.verticalCenter: buyTab.verticalCenter
    anchors.right: capacity.left
    margin-right: 12
    text-auto-resize: true
    color: #E2BD55

  UIItem
    id: moneyIcon
    anchors.verticalCenter: buyTab.verticalCenter
    anchors.right: money.left
    margin-right: 2
    size: 32 32
    virtual: true
    phantom: true

  VerticalScrollBar
    id: gridScroll
    anchors.top: buyTab.bottom
    anchors.right: parent.right
    margin-top: 6
    height: 159
    pixels-scroll: true
    step: 53

  ScrollablePanel
    id: grid
    anchors.top: gridScroll.top
    anchors.bottom: gridScroll.bottom
    anchors.left: parent.left
    width: 500
    vertical-scrollbar: gridScroll
    layout:
      type: grid
      cell-size: 50 53
      cell-spacing: 0
      num-columns: 10

  Label
    id: emptyState
    anchors.fill: grid
    text-align: center
    color: #C4C0B6
    phantom: true

  Label
    id: note
    anchors.top: grid.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 14
    text-align: center
    color: #00EB00

  HorizontalSeparator
    id: separator
    anchors.top: note.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6

  Button
    id: close
    anchors.top: separator.bottom
    anchors.right: parent.right
    margin-top: 6
    width: 64
    text: Close
    @onClick: modules.game_npcshop.hide()

  Button
    id: sellAll
    anchors.top: close.top
    anchors.right: close.left
    margin-right: 4
    width: 64
    text: Sell all
    visible: false
    @onClick: modules.game_npcshop.sellAll()

  Button
    id: action
    anchors.top: close.top
    anchors.right: close.left
    margin-right: 4
    width: 64
    text: Buy
    @onClick: modules.game_npcshop.trade()

  Label
    id: amount
    anchors.verticalCenter: close.verticalCenter
    anchors.right: action.left
    margin-right: 10
    width: 26
    text-align: right
    color: #FFFFFF

  HorizontalScrollBar
    id: amountBar
    anchors.verticalCenter: close.verticalCenter
    anchors.left: parent.left
    anchors.right: amount.left
    margin-right: 4
    step: 1
    minimum: 1
    maximum: 1
